# SUMEXORA PENAL - Environment Configuration
# Copy to .env and fill real values. Never commit .env

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://sumexora:sumexora_secret@localhost:5432/sumexora_penal

# Auth
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Root domain for branded subdomains
ROOT_DOMAIN=sumexora.com

# File Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100

# AI Provider (Gemini)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Cloudflare (DNS + optional hosting)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# Render Hosting Adapter
RENDER_API_KEY=
RENDER_OWNER_ID=

# SSL / ACME (optional advanced)
ACME_EMAIL=admin@sumexora.com

# Subscription defaults (days)
DEFAULT_HOSTING_DURATION_DAYS=30
GRACE_PERIOD_DAYS=7
